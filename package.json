{
  "name": "@cube007/dsh-message-rollback",
  "version": "1.0.0",
  "description": "DeepSeek Harness plugin: edit sent messages and roll back following turns, optionally restoring recorded file changes.",
  "license": "MIT",
  "author": "xCube007",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xCube007/dsh-message-rollback.git"
  },
  "homepage": "https://github.com/xCube007/dsh-message-rollback#readme",
  "bugs": {
    "url": "https://github.com/xCube007/dsh-message-rollback/issues"
  },
  "keywords": ["deepseek", "deepseek-harness", "dsh", "dsh-plugin", "message", "rollback", "edit"],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "rollback.js",
    "files.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node rollback.test.js && node files.test.js && node client.test.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web" }
  }
}
