{
  "name": "dsh-message-rewind",
  "version": "1.2.4",
  "description": "DeepSeek Harness plugin: edit sent messages and roll back following turns, optionally restoring recorded file changes.",
  "license": "MIT",
  "author": "xCube007",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xCube007/dsh-message-rewind.git"
  },
  "homepage": "https://github.com/xCube007/dsh-message-rewind#readme",
  "bugs": {
    "url": "https://github.com/xCube007/dsh-message-rewind/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "message",
    "rewind",
    "rollback",
    "edit"
  ],
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "rewind.js",
    "files.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.en.md"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "scripts": {
    "test": "node manifest.test.js && node rewind.test.js && node files.test.js && node index.test.js && node client.test.js",
    "prepublishOnly": "npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
