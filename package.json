{
  "name": "dsh-message-rewind",
  "version": "1.1.0",
  "description": "DeepSeek Harness plugin: edit sent messages and roll back following turns, optionally restoring recorded file changes.",
  "license": "MIT",
  "author": "xCube007",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xCube007/dsh-message-rewind.git"
  },
  "homepage": "https://github.com/xCube007/dsh-message-rewind#readme",
  "bugs": {
    "url": "https://github.com/xCube007/dsh-message-rewind/issues"
  },
  "keywords": ["deepseek", "deepseek-harness", "dsh", "dsh-plugin", "message", "rewind", "rollback", "edit"],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "rewind.js",
    "files.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.en.md",
    "*.test.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node rewind.test.js && node files.test.js && node index.test.js && node client.test.js",
    "prepublishOnly": "npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web" }
  }
}
